{
  "name": "bistro-e2e-webdriver",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf junit-results json-results videos screenshots",
    "test": "npm run clean && wdio run wdio.conf.ts",
    "test:headed": "npm run clean && wdio run wdio.conf.ts --headed",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "junit-upload": "npx qas-cli junit-upload --attachments --skip-report-stdout on-success junit-results/results-*.xml"
  },
  "keywords": [
    "webdriverio",
    "e2e",
    "testing",
    "typescript"
  ],
  "author": "",
  "license": "0BSD",
  "description": "WebDriver.io E2E tests for Bistro application",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.17.0",
    "@wdio/json-reporter": "^9.20.0",
    "@wdio/junit-reporter": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "chromedriver": "^142.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
